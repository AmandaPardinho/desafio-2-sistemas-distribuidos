{
  "name": "payment-service",
  "version": "1.0.0",
  "description": "Serviço de pagamento da CompreFácil: recebe transações via REST e publica eventos no RabbitMQ",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "test:cov": "jest --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!main.ts",
      "!**/*.module.ts",
      "!test-utils/**"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/test-utils/jest.setup.ts"
    ]
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/swagger": "11.2.0",
    "@prisma/client": "6.19.0",
    "amqp-connection-manager": "4.1.15",
    "amqplib": "0.10.9",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "prisma": "6.19.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "11.0.7",
    "@nestjs/testing": "11.1.6",
    "@types/amqplib": "0.10.7",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/node": "22.18.0",
    "eslint": "9.35.0",
    "eslint-config-prettier": "10.1.8",
    "jest": "29.7.0",
    "prettier": "3.6.2",
    "source-map-support": "0.5.21",
    "ts-jest": "29.4.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.43.0"
  }
}
